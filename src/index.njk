---
layout: base.njk
navCurrent: /
extraCss: ["/assets/cara.css"]
permalink: /index.html
---
{# Cara's four movements: intro, the things, about, contact. Each section is a
   .px-page. The shape field inside it comes from src/_data/shapes.js, grouped
   far to near, and is rendered by the shared macro in field.njk. The sprite it
   points at is in base.njk, on every page. #}
{% import "field.njk" as px %}

<main class="px">

  {# ---------- intro ---------- #}
  <section class="px-page" id="intro">
    <div class="px-divider g1">
      <span class="wide faint" data-speed="0.05"></span>
      <span class="b1" data-speed="0.14"></span>
      <span class="b3" data-speed="-0.09"></span>
    </div>
    <div class="px-glow"></div>
    {{ px.field(shapes.intro) }}

    <div class="px-inner shell">
      <div class="hero rise">
        <div class="hello">{{ site.title }}</div>
        <h1 class="introline">Hi, I am Sinh,</h1>
        <p class="introsub">
          Call me Shin. Welcome to my personal blog. Enjoy!
        </p>
        <p class="introsub">
          I keep a <a href="/whisky/">whisky tasting journal</a> and write the
          odd <a href="/blog/">post</a>.
        </p>
        <a class="scrollcue" href="#things">
          <span class="cueline"></span>
          <span>Have a look <i class="ph ph-arrow-down"></i></span>
        </a>
      </div>
    </div>
  </section>

  {# ---------- the things ---------- #}
  <section class="px-page" id="things">
    <div class="px-divider g2">
      <span class="wide" data-speed="0.06"></span>
      <span class="b2" data-speed="-0.12"></span>
    </div>
    {{ px.field(shapes.things) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>The things<span class="hrule"></span></h2>
      <p class="px-lede" data-reveal>Two of them are worth your time. The rest is in progress.</p>

      <div class="cards" data-reveal data-stagger="110">
        <a class="pcard g2" href="/whisky/">
          <span class="kicker">{{ collections.bottles | length }} bottles</span>
          <b>{{ site.whisky.title }}</b>
          <p>Every dram I have sat down with, scored and written up. Search it, filter it,
            print a shelf card for the bottle in your hand.</p>
          <span class="go">Open the ledger <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g1" href="/blog/">
          <span class="kicker">{{ collections.posts | length }} post{% if collections.posts | length != 1 %}s{% endif %}</span>
          <b>Writing</b>
          <p>My thought, my sharing, my expression. Linux, networks, hardware,
            and the occasional thing that is none of those.</p>
          <span class="go">Read the blog <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g4" href="#about">
          <span class="kicker">Who</span>
          <b>About me</b>
          <p>The short version, one scroll down.</p>
          <span class="go">Keep going <i class="ph ph-arrow-down"></i></span>
        </a>
      </div>
    </div>
  </section>

  {# ---------- about ---------- #}
  <section class="px-page" id="about">
    <div class="px-divider g3">
      <span class="wide" data-speed="0.05"></span>
      <span class="b1" data-speed="0.16"></span>
    </div>
    {{ px.field(shapes.about) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>About<span class="hrule"></span></h2>
      <div class="about" data-reveal data-stagger="130">
        <div class="avatar">
          <img class="brandmark avamark" src="/assets/brand/mark.png" alt="" aria-hidden="true">
        </div>
        <div class="aboutbody">
          <p>I am {{ site.author }}. By day I work on software. By evening I pour something
            peaty, write down what I taste, and argue with myself about whether it was worth
            the money.</p>
          <p>This site is deliberately small: flat markdown files, a static site generator,
            no database and no framework. If a thing can be a file, it is a file.</p>
          <p>The whisky ledger is the part I actually maintain. Everything else here comes
            and goes.</p>
        </div>
      </div>
    </div>
  </section>

  {# ---------- contact ---------- #}
  <section class="px-page" id="contact">
    <div class="px-divider g4">
      <span class="wide" data-speed="0.05"></span>
      <span class="b2" data-speed="0.13"></span>
      <span class="b3" data-speed="-0.1"></span>
    </div>
    {{ px.field(shapes.contact) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>Say hello<span class="hrule"></span></h2>
      <p class="px-lede" data-reveal>Whisky recommendations especially welcome.</p>
      <div data-reveal><a class="bigmail" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <div class="links" data-reveal data-stagger="70">
        {% for s in site.social %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
        <a href="/whisky/">Whisky</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
  </section>

</main>
