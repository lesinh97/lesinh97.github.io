---
layout: base.njk
navCurrent: /
extraCss: ["/assets/cara.css"]
extraJs: ["/assets/parallax.js"]
permalink: /index.html
---
{# Cara's four movements: intro, the things, about, contact. Each section is a
   .px-page; the .px-layer inside it drifts against the scroll at data-speed. #}

<main class="px">

  {# ---------- intro ---------- #}
  <section class="px-page" id="intro">
    <div class="px-divider wash g1"><span></span></div>
    <div class="px-layer" data-speed="0.22">
      <span class="shape line a-updownwide" style="top: 16%; left: 8%; width: 64px; height: 64px; opacity: .5">
        <svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="20"/></svg></span>
      <span class="shape fill a-updown" style="bottom: 9%; left: 34%; width: 26px; height: 26px; opacity: .35">
        <svg viewBox="0 0 44 44"><polygon points="22,4 40,38 4,38"/></svg></span>
      <span class="shape line a-spin" style="top: 24%; right: 16%; width: 96px; height: 96px; opacity: .35">
        <svg viewBox="0 0 44 44"><rect x="6" y="6" width="32" height="32"/></svg></span>
    </div>
    <div class="px-layer" data-speed="0.45">
      <span class="shape fill a-updown" style="top: 74%; right: 24%; width: 18px; height: 18px; opacity: .45">
        <svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="20"/></svg></span>
      <span class="shape line a-updownwide" style="top: 8%; right: 38%; width: 42px; height: 42px; opacity: .3">
        <svg viewBox="0 0 44 44"><polygon points="22,3 41,13 41,31 22,41 3,31 3,13"/></svg></span>
    </div>

    <div class="px-inner shell">
      <div class="hello">Hello</div>
      <h1 class="introline">I am {{ site.author }}.</h1>
      <p class="introsub">
        I keep a <a href="/whisky/">whisky tasting journal</a>, write the odd
        <a href="/blog/">post</a>, and build small things that do one job well.
      </p>
      <a class="scrollcue" href="#things">Have a look <i class="ph ph-arrow-down"></i></a>
    </div>
  </section>

  {# ---------- the things ---------- #}
  <section class="px-page" id="things">
    <div class="px-divider soft g2"><span></span></div>
    <div class="px-layer" data-speed="0.3">
      <span class="shape line a-updownwide" style="top: 12%; right: 8%; width: 78px; height: 78px; opacity: .35">
        <svg viewBox="0 0 44 44"><polygon points="22,4 40,38 4,38"/></svg></span>
      <span class="shape fill a-updown" style="bottom: 14%; left: 6%; width: 22px; height: 22px; opacity: .4">
        <svg viewBox="0 0 44 44"><rect x="4" y="4" width="36" height="36" rx="6"/></svg></span>
    </div>

    <div class="px-inner shell">
      <h2 class="px-h">The things</h2>
      <p class="px-lede">Two of them are worth your time. The rest is in progress.</p>

      <div class="cards">
        <a class="pcard g2" href="/whisky/">
          <span class="kicker">{{ collections.bottles | length }} bottles</span>
          <b>{{ site.whisky.title }}</b>
          <p>Every dram I have sat down with, scored and written up. Search it, filter it,
            print a shelf card for the bottle in your hand.</p>
          <span class="go">Open the ledger <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g1" href="/blog/">
          <span class="kicker">{{ collections.posts | length }} post{% if collections.posts | length != 1 %}s{% endif %}</span>
          <b>Writing</b>
          <p>Notes on what I am reading, building and drinking. Short, irregular,
            and written mostly for me.</p>
          <span class="go">Read the blog <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g4" href="#about">
          <span class="kicker">Who</span>
          <b>About me</b>
          <p>The short version, one scroll down.</p>
          <span class="go">Keep going <i class="ph ph-arrow-down"></i></span>
        </a>
      </div>
    </div>
  </section>

  {# ---------- about ---------- #}
  <section class="px-page" id="about">
    <div class="px-divider soft g3"><span></span></div>
    <div class="px-layer" data-speed="0.26">
      <span class="shape line a-spin-slow" style="top: 9%; right: 7%; width: 110px; height: 110px; opacity: .28">
        <svg viewBox="0 0 44 44"><polygon points="22,3 41,13 41,31 22,41 3,31 3,13"/></svg></span>
      <span class="shape fill a-updownwide" style="bottom: 14%; left: 9%; width: 20px; height: 20px; opacity: .4">
        <svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="20"/></svg></span>
    </div>

    <div class="px-inner shell">
      <h2 class="px-h">About</h2>
      <div class="about">
        <div class="avatar">{{ site.author | first }}</div>
        <div class="aboutbody">
          <p>I am {{ site.author }}. By day I work on software. By evening I pour something
            peaty, write down what I taste, and argue with myself about whether it was worth
            the money.</p>
          <p>This site is deliberately small: flat markdown files, a static site generator,
            no database and no framework. If a thing can be a file, it is a file.</p>
          <p>The whisky ledger is the part I actually maintain. Everything else here comes
            and goes.</p>
        </div>
      </div>
    </div>
  </section>

  {# ---------- contact ---------- #}
  <section class="px-page" id="contact">
    <div class="px-divider soft g4"><span></span></div>
    <div class="px-layer" data-speed="0.2">
      <span class="shape line a-updownwide" style="top: 22%; right: 10%; width: 70px; height: 70px; opacity: .3">
        <svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="20"/></svg></span>
      <span class="shape fill a-updown" style="bottom: 11%; left: 16%; width: 24px; height: 24px; opacity: .35">
        <svg viewBox="0 0 44 44"><polygon points="22,4 40,38 4,38"/></svg></span>
    </div>

    <div class="px-inner shell">
      <h2 class="px-h">Say hello</h2>
      <p class="px-lede">Whisky recommendations especially welcome.</p>
      <a class="bigmail" href="mailto:{{ site.email }}">{{ site.email }}</a>
      <div class="links">
        {% for s in site.social %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
        <a href="/whisky/">Whisky</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
  </section>

</main>
