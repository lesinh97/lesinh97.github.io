---
layout: base.njk
navCurrent: /
extraCss: ["/assets/cara.css"]
permalink: /index.html
---
{# Cara's four movements: intro, the things, about, contact. Each section is a
   .px-page. The shape field inside it comes from src/_data/shapes.js, grouped
   far to near, and is rendered by the shared macro in field.njk. The sprite it
   points at is in base.njk, on every page. #}
{% import "field.njk" as px %}

<main class="px">

  {# ---------- intro ---------- #}
  <section class="px-page" id="intro">
    <div class="px-divider g1">
      <span class="wide faint" data-speed="0.05"></span>
      <span class="b1" data-speed="0.14"></span>
      <span class="b3" data-speed="-0.09"></span>
    </div>
    <div class="px-glow"></div>
    {{ px.field(shapes.intro) }}

    <div class="px-inner shell">
      <div class="hero rise">
        <div class="hello">{{ site.title }}</div>
        <h1 class="introline">Hi, I am Sinh,</h1>
        {# Both names for the job: the one he calls it, and the one a recruiter
           is searching for. #}
        <div class="rolerow">
          <span class="proppill">{{ cv.headline }}</span>
          <span class="rolewhere">{{ cv.location }}</span>
        </div>
        <p class="introsub">
          Call me Shin. I'm a data engineer, and I'd rather ship one well-tested
          model than three clever ones.
        </p>
        <p class="introsub">
          I keep a <a href="/whisky/">whisky tasting journal</a> and write the
          odd <a href="/blog/">post</a>.
        </p>
        <a class="scrollcue" href="#work">
          <span class="cueline"></span>
          <span>What I do <i class="ph ph-arrow-down"></i></span>
        </a>
      </div>
    </div>
  </section>

  {# ---------- work ---------- #}
  {# The professional half of the page. Everything here comes out of
     src/_data/cv.json, which was filled from the LinkedIn export, so there is
     one place to correct a date and no second copy to drift. #}
  <section class="px-page" id="work">
    <div class="px-divider g3">
      <span class="wide" data-speed="0.05"></span>
      <span class="b1" data-speed="0.12"></span>
      <span class="b3" data-speed="-0.08"></span>
    </div>
    {{ px.field(shapes.work) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>What I do<span class="hrule"></span></h2>
      <p class="px-lede worklede" data-reveal>{{ cv.summary }}</p>
      {# `arc` is my sentence, not Shin's. Every fact in it is off the roles
         list, but the voice is not his: rewrite it when you get a minute. #}
      {% if cv.arc %}<p class="px-lede worklede workarc" data-reveal>{{ cv.arc }}</p>{% endif %}

      {% if cv.skills | hasAny("items") %}
      <div class="stack" data-reveal data-stagger="70">
        {% for g in cv.skills %}{% if g.items | length %}
        <div class="stackgroup">
          <span class="stackname">{{ g.group }}</span>
          <div class="stacktags">
            {% for i in g.items %}<span class="tag tag-accent">{{ i }}</span>{% endfor %}
          </div>
        </div>
        {% endif %}{% endfor %}
      </div>
      {% endif %}

      {% if cv.roles | hasAny("title,org") %}
      <div class="lbl worklbl" data-reveal>Workplace</div>
      <div class="track" data-reveal data-stagger="60">
        {% for r in cv.roles %}{% if r.title or r.org %}
        <div class="stop">
          <span class="stopwhen">
            {{- r.from | shortMonth }} - {{ (r.to | shortMonth) or "Now" -}}
          </span>
          <span class="stopwhat">
            <b>{{ r.title }}</b>
            <span class="stoporg">{{ r.org }}{% if r.location %} · {{ r.location }}{% endif %}</span>
          </span>
        </div>
        {% endif %}{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  {# ---------- the things ---------- #}
  <section class="px-page" id="things">
    <div class="px-divider g2">
      <span class="wide" data-speed="0.06"></span>
      <span class="b2" data-speed="-0.12"></span>
    </div>
    {{ px.field(shapes.things) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>The things<span class="hrule"></span></h2>
      <p class="px-lede" data-reveal>Two of them are worth your time. The rest is in progress.</p>

      <div class="cards" data-reveal data-stagger="110">
        <a class="pcard g2" href="/whisky/">
          <span class="kicker">{{ collections.bottles | length }} bottles</span>
          <b>{{ site.whisky.title }}</b>
          <p>Every dram I have sat down with, scored and written up. Search it, filter it,
            print a shelf card for the bottle in your hand.</p>
          <span class="go">Open the ledger <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g1" href="/blog/">
          <span class="kicker">{{ collections.posts | length }} post{% if collections.posts | length != 1 %}s{% endif %}</span>
          <b>Writing</b>
          <p>My thought, my sharing, my expression. Linux, networks, hardware,
            and the occasional thing that is none of those.</p>
          <span class="go">Read the blog <i class="ph ph-arrow-right"></i></span>
        </a>

        <a class="pcard g4" href="#about">
          <span class="kicker">Who</span>
          <b>About me</b>
          <p>The short version, one scroll down.</p>
          <span class="go">Keep going <i class="ph ph-arrow-down"></i></span>
        </a>
      </div>
    </div>
  </section>

  {# ---------- about ---------- #}
  <section class="px-page" id="about">
    <div class="px-divider g3">
      <span class="wide" data-speed="0.05"></span>
      <span class="b1" data-speed="0.16"></span>
    </div>
    {{ px.field(shapes.about) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>About<span class="hrule"></span></h2>
      <div class="about" data-reveal data-stagger="130">
        <div class="avatar">
          <img class="brandmark avamark" src="/assets/brand/mark.png" alt="" aria-hidden="true">
        </div>
        <div class="aboutbody">
          <p>I am {{ site.author }}. By day I work on software. By evening I pour something
            peaty, write down what I taste, and argue with myself about whether it was worth
            the money.</p>
          <p>This site is deliberately small: flat markdown files, a static site generator,
            no database and no framework. If a thing can be a file, it is a file.</p>
          <p>Most of the writing here is old: iptables rules, Linux memory management, an
            Arduino attendance reader I built at university. Hardware and networks, not data.</p>
          <p>The whisky ledger is the part I actually maintain. Everything else here comes
            and goes.</p>
        </div>
      </div>

      {# The rest of the paperwork, small and out of the way: a recruiter who
         wants it can find it, and nobody else has to read past it. #}
      <div class="creds" data-reveal data-stagger="60">
        {% if cv.education | hasAny("school") %}
        <div class="cred">
          <span class="credname">Studied</span>
          {% for e in cv.education %}{% if e.school %}
          <span class="credline">{{ e.award }}, {{ e.school }}{% if e.from %} ({{ e.from }} - {{ e.to or "Now" }}){% endif %}</span>
          {% endif %}{% endfor %}
        </div>
        {% endif %}

        {% if cv.honours | hasAny("name") %}
        <div class="cred">
          <span class="credname">Awarded</span>
          <span class="credline">
            {%- for h in cv.honours %}{% if h.name %}
              {{- h.name }}{% if h.issuer %}, {{ h.issuer }}{% endif %}{% if not loop.last %}; {% endif %}
            {%- endif %}{% endfor -%}
          </span>
        </div>
        {% endif %}

        {% if cv.languages | hasAny("name") %}
        <div class="cred">
          <span class="credname">Speaks</span>
          <span class="credline">
            {%- for l in cv.languages %}{% if l.name %}
              {{- l.name }}{% if l.level %} ({{ l.level | lower }}){% endif %}{% if not loop.last %}, {% endif %}
            {%- endif %}{% endfor -%}
          </span>
        </div>
        {% endif %}

        {% if cv.certifications | hasAny("name") %}
        <div class="cred">
          <span class="credname">Certified</span>
          <ul class="credlist">
            {% for c in cv.certifications %}{% if c.name %}
            <li>{{ c.name }}{% if c.issuer %} <span class="credby">{{ c.issuer }}</span>{% endif %}</li>
            {% endif %}{% endfor %}
          </ul>
        </div>
        {% endif %}
      </div>
    </div>
  </section>

  {# ---------- contact ---------- #}
  <section class="px-page" id="contact">
    <div class="px-divider g4">
      <span class="wide" data-speed="0.05"></span>
      <span class="b2" data-speed="0.13"></span>
      <span class="b3" data-speed="-0.1"></span>
    </div>
    {{ px.field(shapes.contact) }}

    <div class="px-inner shell">
      <h2 class="px-h" data-reveal>Say hello<span class="hrule"></span></h2>
      <p class="px-lede" data-reveal>Whisky recommendations especially welcome.</p>
      <div data-reveal><a class="bigmail" href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      <div class="links" data-reveal data-stagger="70">
        {% for s in site.social %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
        <a href="/whisky/">Whisky</a>
        <a href="/blog/">Blog</a>
      </div>
    </div>
  </section>

</main>
