<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Bottles carry `name`, posts carry `title`, plain pages set `pageTitle`. #}
{% set ptitle = pageTitle or name or title %}
<title>{% if ptitle %}{{ ptitle }} · {{ site.title }}{% else %}{{ site.headline or site.title }}{% endif %}</title>
<meta name="description" content="{{ pageDescription or summary or site.description }}">
<meta property="og:title" content="{{ ptitle or site.headline or site.title }}">
<meta property="og:description" content="{{ pageDescription or summary or site.description }}">
<meta property="og:image" content="/assets/brand/banner.png">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/assets/brand/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
{# Set the mode before the first paint, so a light-mode visitor never sees a
   dark flash. Kept inline and tiny on purpose. #}
<script>
  (function () {
    try {
      var m = localStorage.getItem("shinology-theme");
      if (m !== "light" && m !== "dark") {
        m = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      }
      document.documentElement.setAttribute("data-theme", m);
    } catch (e) {}
  })();
</script>
{# The signature is katakana. Without this the browser falls back to a
   brush-style system face that does not match the rest of the card.
   Google serves it as unicode-range subsets, so only the glyphs used load. #}
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/nocturne.css">
<link rel="stylesheet" href="/assets/theme.css">
{# The shared motion layer: bands, the drifting field, arrivals. Every page
   gets it, so no page looks like it belongs to a different site. #}
<link rel="stylesheet" href="/assets/motion.css">
{% for href in extraCss %}<link rel="stylesheet" href="{{ href }}">
{% endfor %}
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
{% if pageCss %}<style>{{ pageCss | safe }}</style>{% endif %}
</head>
<body>

{% include "sprite.njk" %}

{% if not hideNav %}
<header class="topnav">
  <div class="shell">
    <a class="navbrand" href="/">
      <img class="brandmark navmark" src="/assets/brand/mark.png" alt="" aria-hidden="true">
      <span>{{ site.title }}</span>
    </a>
    {% for n in site.nav %}
    <a class="navlink" href="{{ n.url }}"{% if n.url == navCurrent %} aria-current="page"{% endif %}>{{ n.label }}</a>
    {% endfor %}
    <button class="modetoggle" type="button" aria-pressed="false" aria-label="Switch colour mode" title="Switch colour mode">
      <i class="ph ph-moon i-moon" aria-hidden="true"></i><i class="ph ph-sun i-sun" aria-hidden="true"></i>
    </button>
  </div>
</header>
{% endif %}

{{ content | safe }}

{% if not hideFooter %}
<footer class="sitefoot">
  <div class="shell">
    <span style="margin-right: auto">{{ site.headline or site.title }}</span>
    {% for s in site.social %}<a href="{{ s.url }}">{{ s.label }}</a>{% endfor %}
  </div>
</footer>
{% endif %}

{# Belt and braces alongside /sw.js: once a browser reaches the real site,
   drop any leftover worker and cache from the old Gatsby build. #}
<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.getRegistrations().then(function (rs) {
      rs.forEach(function (r) { r.unregister(); });
    }).catch(function () {});
    if (window.caches && caches.keys) {
      caches.keys().then(function (ks) {
        ks.forEach(function (k) { caches.delete(k); });
      }).catch(function () {});
    }
  }
</script>
<script src="/assets/theme-toggle.js"></script>
{# Both bail out on a page that has no hooks for them, so they are loaded
   everywhere rather than listed per page in extraJs. #}
<script src="/assets/motion.js"></script>
<script src="/assets/parallax.js"></script>
{% for src in extraJs %}<script src="{{ src }}"></script>
{% endfor %}
</body>
</html>
