---
layout: base.njk
navCurrent: /blog/
extraCss: ["/assets/blog.css"]
extraJs: ["/assets/comments.js"]
---
{% import "field.njk" as px %}

<article>
  <header class="pagehead">
    {{ px.band(4) }}
    {{ px.field(shapes.post) }}
    <div class="shell rise" style="max-width: 720px">
      <div class="meta">
        <span>{{ date | readableDate }}</span>
        {% if readingTime %}<span>{{ readingTime }}</span>{% endif %}
      </div>
      <h1>{{ title }}</h1>
      {% if summary %}<p>{{ summary }}</p>{% endif %}
    </div>
  </header>

  {% if image %}<div class="posthero" data-reveal><img src="{{ image }}" alt=""></div>{% endif %}

  <div class="post">
    <div class="prose">{{ content | safe }}</div>

    {% if topics %}
    <div class="posttags" data-reveal data-stagger="60">
      {% for t in topics %}<span class="tag tag-accent">{{ t }}</span>{% endfor %}
    </div>
    {% endif %}

    {% include "comments.njk" %}

    <a class="backlink" href="/blog/"><i class="ph ph-arrow-left"></i>All posts</a>
  </div>
</article>
