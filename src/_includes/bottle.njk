---
layout: base.njk
navCurrent: /whisky/
extraCss: ["/assets/bottle.css"]
---
{% import "field.njk" as px %}

{# A full-bleed backdrop behind the top of the page. It has no positioned
   ancestor on purpose, so it measures against the initial containing block and
   spans the viewport width rather than the 880px note column. #}
<div class="pxback">
  {{ px.band(3) }}
  {{ px.field(shapes.bottle) }}
</div>

<div class="bwrap">
  <article class="sheet rise">
    <div class="head">
      {% if photo %}<div class="shot"><img src="{{ photo }}" alt="{{ name }}" decoding="async"></div>{% endif %}
      <div style="flex: 1; min-width: 0">
        <div class="kick">{{ origin }}{% if type %}  ·  {{ type }}{% endif %}</div>
        <h1>{{ name }}</h1>
        <div class="line">{{ age }}{% if abv %}  ·  {{ abv }}{% endif %}{% if cask %}  ·  {{ cask }}{% endif %}</div>
      </div>
      {# A bottle can be on the shelf before it is opened. The dash matches the
         one the ledger shows for the same state. #}
      <div class="score">{% if score %}<b>{{ score }}</b><span>out of ten</span>
        {% else %}<b>–</b><span>not scored yet</span>{% endif %}</div>
    </div>

    <div class="facts" data-reveal data-stagger="70">
      <div class="fact"><span>Tasted</span><b>{{ (tasted | readableDate) or "Not yet" }}</b></div>
      <div class="fact"><span>Age</span><b>{{ age or "NAS" }}</b></div>
      <div class="fact"><span>Strength</span><b>{{ abv or "Not listed" }}</b></div>
      <div class="fact"><span>Cask</span><b>{{ cask or "Not listed" }}</b></div>
    </div>

    <div class="body">
      {# Theme-aware ramp, shared with the sparkline in app.js. #}
      {% set ramp = ["var(--bar-0)", "var(--bar-1)", "var(--bar-2)", "var(--bar-3)", "var(--bar-4)", "var(--bar-5)"] %}
      {% set rows = [["Fruit & floral", fam.fruit], ["Sweet & creamy", fam.sweet], ["Spice & dried fruit", fam.spice],
                     ["Oak & nut", fam.oak], ["Malt & grain", fam.malt], ["Smoke & peat", fam.peat]] %}
      <div class="lbl">Flavour signature</div>
      <div class="bars" data-reveal data-stagger="60">
        {% for r in rows %}
        {% set v = r[1] or 0 %}
        <div class="fbar">
          <span>{{ r[0] }}</span>
          <span class="track"><i style="width: {{ v * 20 }}%; background: {{ ramp[v] }}"></i></span>
          <span class="fval">{{ v }}</span>
        </div>
        {% endfor %}
      </div>

      <hr class="brule">

      {% if nose %}<div class="note"><span>Nose</span><p>{{ nose }}</p></div>{% endif %}
      {% if palate %}<div class="note"><span>Palate</span><p>{{ palate }}</p></div>{% endif %}
      {% if finish %}<div class="note"><span>Finish</span><p>{{ finish }}</p></div>{% endif %}

      {% if content | striptags | trim %}
      <hr class="brule">
      <div class="lbl" style="margin-bottom: 12px">Behind it</div>
      <div class="prose">{{ content | safe }}</div>
      {% endif %}

      {% if flavours %}
      <div class="tags" data-reveal data-stagger="45">
        {% for t in flavours %}<span class="tag tag-accent">{{ t }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </article>

  <a class="backlink" href="/whisky/"><i class="ph ph-arrow-left"></i>All bottles</a>
</div>
