---
layout: base.njk
navCurrent: /cv/
pageTitle: CV
pageDescription: What I work on, and what I have shipped.
extraCss: ["/assets/cv.css"]
permalink: /cv/index.html
---
{% import "field.njk" as px %}

{# Every block below is guarded. An empty list in src/_data/cv.json renders
   nothing at all, so the page is never a set of headings with gaps under them. #}

<header class="pagehead">
  {{ px.band(4) }}
  {{ px.field(shapes.post) }}
  <div class="shell rise">
    <span class="cvmark"><img class="brandmark" src="/assets/brand/mark.png" alt="" aria-hidden="true"></span>
    <div class="kicker">{{ cv.headline or "Software" }}</div>
    <h1>{{ cv.name or site.author }}<span class="hrule"></span></h1>
    <p>{{ cv.summary }}</p>
    <div class="cvlinks">
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      {% for s in site.social %}{% if s.label != "Email" %}<a href="{{ s.url }}">{{ s.label }}</a>{% endif %}{% endfor %}
      {% for l in cv.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}
      {% if cv.location %}<span class="cvwhere">{{ cv.location }}</span>{% endif %}
    </div>
  </div>
</header>

<div class="shell"><div class="cvwrap">

  {# ---------- experience ---------- #}
  {% if cv.roles | hasAny("title,org") %}
  <section class="cvsec" data-reveal>
    <div class="lbl">Experience</div>
    <div class="cvlist">
      {% for r in cv.roles %}{% if r.title or r.org %}
      <div class="cvrole">
        <div class="cvwhen">{{ r.from }}{% if r.to %} to {{ r.to }}{% elif r.from %} to now{% endif %}</div>
        <div class="cvbody">
          <b>{{ r.title }}</b>
          <div class="cvorg">
            {%- if r.url %}<a href="{{ r.url }}">{{ r.org }}</a>{% else %}{{ r.org }}{% endif -%}
            {%- if r.location %} · {{ r.location }}{% endif -%}
          </div>
          {% if r.points | length %}
          <ul>{% for p in r.points %}<li>{{ p }}</li>{% endfor %}</ul>
          {% endif %}
        </div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- skills ---------- #}
  {% if cv.skills | hasAny("items") %}
  <section class="cvsec" data-reveal>
    <div class="lbl">What I work with</div>
    <div class="cvskills">
      {% for g in cv.skills %}{% if g.items | length %}
      <div class="cvgroup">
        <span class="cvgname">{{ g.group }}</span>
        <div class="cvtags">{% for i in g.items %}<span class="tag tag-accent">{{ i }}</span>{% endfor %}</div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- education ---------- #}
  {% if cv.education | hasAny("school") %}
  <section class="cvsec" data-reveal>
    <div class="lbl">Education</div>
    <div class="cvlist">
      {% for e in cv.education %}{% if e.school %}
      <div class="cvrole">
        <div class="cvwhen">{{ e.from }}{% if e.to %} to {{ e.to }}{% endif %}</div>
        <div class="cvbody"><b>{{ e.award }}</b><div class="cvorg">{{ e.school }}</div></div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- certifications ---------- #}
  {% if cv.certifications | hasAny("name") %}
  <section class="cvsec" data-reveal>
    <div class="lbl">Certifications</div>
    <div class="cvlist">
      {% for c in cv.certifications %}{% if c.name %}
      <div class="cvrole">
        <div class="cvwhen">{{ c.year }}</div>
        <div class="cvbody"><b>{{ c.name }}</b><div class="cvorg">{{ c.issuer }}</div></div>
      </div>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- languages ---------- #}
  {% if cv.languages | hasAny("name") %}
  <section class="cvsec" data-reveal>
    <div class="lbl">Languages</div>
    <div class="cvtags">
      {% for l in cv.languages %}{% if l.name %}
      <span class="tag tag-accent">{{ l.name }}{% if l.level %} · {{ l.level }}{% endif %}</span>
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- writing, straight off the blog ---------- #}
  {% if collections.posts | length %}
  <section class="cvsec" data-reveal>
    <div class="lbl">Selected writing</div>
    <div class="cvlist">
      {% for p in collections.posts %}
      <div class="cvrole">
        <div class="cvwhen">{{ p.data.date | readableDate }}</div>
        <div class="cvbody">
          <b><a href="{{ p.url }}">{{ p.data.title }}</a></b>
          {% if p.data.summary %}<div class="cvorg">{{ p.data.summary }}</div>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---------- the side project, which is most of this site ---------- #}
  <section class="cvsec" data-reveal>
    <div class="lbl">Built</div>
    <div class="cvlist">
      <div class="cvrole">
        <div class="cvwhen">This site</div>
        <div class="cvbody">
          <b><a href="/whisky/">{{ site.whisky.title }}</a></b>
          <div class="cvorg">A whisky tasting journal: {{ collections.bottles | length }} notes in flat
            markdown, a searchable ledger with no framework or database, and printable shelf cards.
            Static Eleventy, vanilla JavaScript, no build step.</div>
        </div>
      </div>
    </div>
  </section>

</div></div>
